{
  "theme": "Dark",
  "theme_dark": "dark-cosmos-sidebar",
  "link_click": "Command",
  "font_size": 22,
  "ui_font_size": 19,
  "font_family": "ComicShannsMono Nerd Font",
  "font_weight": 600,
  "tabs": "Vertical",
  "pane_headers": "Always",
  "opacity": 70,
  "density": "Islands",
  "surface_tab_width": 4,
  "prefs_width": 481,
  "keybinds": {
    "ctrl+a>%": "split_right",
    "ctrl+a>\"": "split_down",
    "ctrl+a>h": "focus_pane:left",
    "ctrl+a>j": "focus_pane:down",
    "ctrl+a>k": "focus_pane:up",
    "ctrl+a>l": "focus_pane:right",
    "ctrl+a>left": "focus_pane:left",
    "ctrl+a>down": "focus_pane:down",
    "ctrl+a>up": "focus_pane:up",
    "ctrl+a>right": "focus_pane:right",
    "ctrl+a>tab": "next_pane",
    "ctrl+a>shift+tab": "previous_pane",
    "ctrl+a>c": "new_tab",
    "ctrl+a>,": "rename_tab",
    "ctrl+a>shift+x": "close_tab",
    "ctrl+a>x": "close_pane",
    "ctrl+a>z": "zoom",
    "ctrl+a>a": "toggle_sidebar",
    "ctrl+a>1": "goto_tab:1",
    "ctrl+a>2": "goto_tab:2",
    "ctrl+a>3": "goto_tab:3",
    "ctrl+a>4": "goto_tab:4",
    "ctrl+a>5": "goto_tab:5",
    "ctrl+a>6": "goto_tab:6",
    "ctrl+a>7": "goto_tab:7",
    "ctrl+a>8": "goto_tab:8",
    "ctrl+a>9": "goto_tab:9",
    "alt+left": "previous_tab",
    "alt+h": "previous_tab",
    "alt+right": "next_tab",
    "alt+l": "next_tab",
    "ctrl+a>r>h": "resize_split:left",
    "ctrl+a>r>j": "resize_split:down",
    "ctrl+a>r>k": "resize_split:up",
    "ctrl+a>r>l": "resize_split:right",
    "ctrl+a>r>left": "resize_split:left",
    "ctrl+a>r>down": "resize_split:down",
    "ctrl+a>r>up": "resize_split:up",
    "ctrl+a>r>right": "resize_split:right"
  },
  "files": {
    "wrap_prose": false
  },
  "file_tree": {
    "open": true,
    "width": 379
  },
  "git": {
    "diff_hunk_view": true,
    "path_tree": true
  }
}
