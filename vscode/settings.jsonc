{
    "window.autoDetectColorScheme": false,
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontFamily": "'ComicShannsMono Nerd Font', monospace",
    "editor.fontSize": 18,
    "editor.fontWeight": "100",
    "editor.fontLigatures": "'calt' off, 'liga' off",
    "terminal.integrated.fontFamily": "'ComicShannsMono Nerd Font', monospace",
    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontWeight": "400",
    "scm.inputFontSize": 18,
    "chat.fontSize": 22,
    "chat.editor.fontSize": 18,

    "window.titleBarStyle": "custom",
    "window.title": "${remoteName}${separator}${rootNameShort}",
    "workbench.sideBar.location": "left",
    "workbench.panel.defaultLocation": "bottom",
    "explorer.autoReveal": false,
    "workbench.navigationControl.enabled": false,
    "workbench.editor.showIcons": true,
    "workbench.editor.enablePreview": true,
    "workbench.editor.enablePreviewFromQuickOpen": true,
    "workbench.editor.enablePreviewFromCodeNavigation": true,
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.editor.tabActionLocation": "right",
    "workbench.editor.pinnedTabsOnSeparateRow": false,
    "workbench.editor.decorations.badges": false,
    "workbench.editor.decorations.colors": false,

    "editor.bracketPairColorization.enabled": true,
    "editor.codeLens": false,
    "editor.inlayHints.enabled": "off",
    "editor.renderWhitespace": "none",
    "editor.accessibilitySupport": "off",
    "editor.selectionClipboard": false,
    "editor.dragAndDrop": false,
    "editor.guides.indentation": false,
    "editor.guides.highlightActiveIndentation": false,
    "editor.lightbulb.enabled": "off",
    "editor.stickyScroll.enabled": false,
    "editor.semanticHighlighting.enabled": true,
    "editor.wordWrap": "off",
    "editor.mouseWheelZoom": true,
    "editor.mouseWheelScrollSensitivity": 1,
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "off",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "visible",
    // Hide overview-ruler markers without disabling diagnostics or text highlights.
    "workbench.colorCustomizations": {
        "editorOverviewRuler.errorForeground": "#00000000",
        "editorOverviewRuler.warningForeground": "#00000000",
        "editorOverviewRuler.infoForeground": "#00000000",
        "editorOverviewRuler.findMatchForeground": "#00000000",
        "editorOverviewRuler.rangeHighlightForeground": "#00000000",
        "editorOverviewRuler.selectionHighlightForeground": "#00000000",
        "editorOverviewRuler.wordHighlightForeground": "#00000000",
        "editorOverviewRuler.wordHighlightStrongForeground": "#00000000",
        "editorOverviewRuler.wordHighlightTextForeground": "#00000000",
        "editorOverviewRuler.bracketMatchForeground": "#00000000"
    },
    "editor.hideCursorInOverviewRuler": true,
    "editor.minimap.enabled": false,
    "diffEditor.renderSideBySide": false,

    "git.enabled": true,
    "git.openDiffOnClick": true,
    "git.blame.editorDecoration.enabled": false,
    "git.detectWorktrees": true,
    "git.detectSubmodules": true,
    "gitlens.currentLine.enabled": false,
    "github.showAvatar": true,
    "scm.defaultViewMode": "tree",
    "scm.defaultViewSortKey": "path",
    "scm.alwaysShowActions": true,
    "scm.diffDecorations": "gutter",

    "http.proxy": "",
    "window.restoreWindows": "none",
    "window.openFilesInNewWindow": "off",
    "window.openFoldersInNewWindow": "off",
    "workbench.startupEditor": "none",
    "terminal.integrated.hideOnStartup": "always",
    "terminal.integrated.showHistoryOnRestore": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "terminal.integrated.shellIntegration.showCommandGuide": false,
    "update.mode": "none",
    "files.autoSave": "off",
    "files.insertFinalNewline": false,
    "files.trimTrailingWhitespace": false,
    // Zed's default is manual formatting; Markdown also explicitly disables save formatting.
    "editor.formatOnSave": false,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    // Disable inline AI completions and edit predictions without disabling Chat.
    "editor.inlineSuggest.enabled": false,
    "github.copilot.enable": {
        "*": false
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "terminal.integrated.suggest.enabled": false,

    // Let the translated terminal shortcuts/chords reach VS Code, not the shell.
    "terminal.integrated.allowChords": true,
    "terminal.integrated.sendKeybindingsToShell": false,

    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "prettier.tabWidth": 4,
        "prettier.useTabs": false
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "prettier.tabWidth": 4,
        "prettier.useTabs": false
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": false,
        "editor.wordWrap": "off"
    },
    "python-envs.terminal.autoActivationType": "off",
    "python.terminal.activateEnvironment": false,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "ruff.lint.ignore": ["RUF012", "I001"],
    "[shellscript]": {
        "editor.defaultFormatter": "mkhl.shfmt",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    // mkhl.shfmt supplies --filename itself and requires shfmt on PATH.
    "shfmt.executableArgs": [
        "--indent",
        "4"
    ],
    "chat.titleBar.signIn.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.editor.useModal": "off",
    "window.menuBarVisibility": "compact",
    "workbench.colorTheme": "Dark Modern",
    "workbench.editor.empty.hint": "hidden",
    "makefile.configureOnOpen": false,
    "terminal.integrated.initialHint": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "window.commandCenter": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "remote.SSH.remotePlatform": {
        "buble_rpi": "linux"
    },
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "cmake.configureOnOpen": false,
    "cmake.configureOnEdit": false,
    "workbench.editor.showTabs": "none",
    "workbench.activityBar.location": "hidden",
    "workbench.statusBar.visible": false,
    "cmake.languageServerOnlyMode": true
}
