{
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.docker/config.json",
        "~/.kube/config",
        "~/.env",
        "~/SecondBrain"
      ]
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": false
}
