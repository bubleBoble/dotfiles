{
    "$schema": "https://opencode.ai/v2/cli.json",
    "plugins": [
        "-session-changes",
        "./plugins/git-status"
    ],
    "theme": {
        "name": "cursor",
        "mode": "dark"
    },
    "diffs": {
        "tree": true,
        "view": "auto",
        "wrap": "word",
        "single": false
    },
    "animations": false,
    "session": {
        "sidebar": "auto",
        "scrollbar": false,
        "thinking": "show",
        "markdown": "rendered",
        "verbosity": "low",
        "new_location": "launch",
        "tps": false,
        "permissions": "autoaccept"
    },
    "tabs": {
        "mode": "on",
        "layout": "horizontal",
        "indicators": "numbers"
    },
    "attention": {
        "volume": 0.10000000000000003
    },
    "terminal": {
        "title": true,
        "copy": "select"
    }
}
