// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        // Do not let Ctrl-Q quit Zed when focus is outside a file editor.
        "unbind": {
            "ctrl-alt-z": "edit_prediction::RatePredictions",
            "ctrl-q": "zed::Quit",
            "ctrl-shift-w": "workspace::CloseWindow",
        },
        // Override Linux's Editor-level backward-selection shortcut.
        "bindings": {
            "alt-shift-w": "multi_workspace::ToggleWorkspaceSidebar",
            "alt-shift-q": "workspace::ToggleRightDock",
        },
    },
    {
        "context": "AgentDiff",
        "unbind": {
            "ctrl-alt-z": "agent::Reject",
        },
    },
    {
        "context": "Editor && editor_agent_diff",
        "unbind": {
            "ctrl-alt-z": "agent::Reject",
        },
    },
    {
        "context": "Editor && mode == full",
        "bindings": {
            "ctrl-q": "pane::CloseActiveItem",
            "alt-shift-f": "editor::FormatSelections",
            "alt-shift-t": "editor::ToggleTabBar",
            "alt-shift-b": "editor::ToggleBreadcrumb",
        },
    },
    {
        "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual) && !menu",
        "bindings": {
            "ctrl-e": ["action::Sequence", ["vim::LineDown", "vim::LineDown"]],
            "ctrl-y": ["action::Sequence", ["vim::LineUp", "vim::LineUp"]],
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-j": "workspace::ActivatePaneDown",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-l": "workspace::ActivatePaneRight",
        },
    },
    {
        "context": "Editor && mode == full && vim_mode == normal && !menu",
        // Remove longer gr chords so gr opens references without a timeout.
        "unbind": {},
        "bindings": {
            // Zed's ResizePaneDown shrinks height; ResizePaneUp grows it.
            "shift-up": [
                "action::Sequence",
                ["vim::ResizePaneDown", "vim::ResizePaneDown"],
            ],
            "shift-down": [
                "action::Sequence",
                ["vim::ResizePaneUp", "vim::ResizePaneUp"],
            ],
            "shift-left": [
                "action::Sequence",
                ["vim::ResizePaneLeft", "vim::ResizePaneLeft"],
            ],
            "shift-right": [
                "action::Sequence",
                ["vim::ResizePaneRight", "vim::ResizePaneRight"],
            ],
            "tab": "pane::ActivateNextItem",
            "shift-tab": "pane::ActivatePreviousItem",
            "space e": "project_panel::ToggleFocus",
            "space ?": "zed::OpenKeymap",
            "space t t": "editor::ToggleTabBar",
            "space t b": "editor::ToggleBreadcrumb",
        },
    },
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "space e": "project_panel::ToggleFocus",
            "ctrl-h": "workspace::ActivatePaneLeft",
            "ctrl-j": "workspace::ActivatePaneDown",
            "ctrl-k": "workspace::ActivatePaneUp",
            "ctrl-l": "workspace::ActivatePaneRight",
        },
    },
    {
        "context": "Workspace",
        "unbind": {
            "ctrl-alt-j": "multi_workspace::ToggleWorkspaceSidebar",
            "ctrl-alt-shift-b": "git::Branch",
            "ctrl-alt-b": "workspace::ToggleRightDock",
            "ctrl-shift-r": [
                "task::Rerun",
                {
                    "reevaluate_context": false,
                },
            ],
        },
        "bindings": {
            "ctrl-shift-r": "pane::RevealInProjectPanel",
        },
    },
    {
        "context": "Workspace",
        "bindings": {
            "alt-r": "terminal_panel::ToggleFocus",
            "alt-e": "workspace::ToggleZoom",
        },
    },
    {
        "context": "Terminal",
        "bindings": {
            "ctrl-a h": "workspace::ActivatePaneLeft",
            "ctrl-a left": "workspace::ActivatePaneLeft",
            "ctrl-a j": "workspace::ActivatePaneDown",
            "ctrl-a down": "workspace::ActivatePaneDown",
            "ctrl-a k": "workspace::ActivatePaneUp",
            "ctrl-a up": "workspace::ActivatePaneUp",
            "ctrl-a l": "workspace::ActivatePaneRight",
            "ctrl-a right": "workspace::ActivatePaneRight",
            "ctrl-a %": "pane::SplitRight",
            "ctrl-a \"": "pane::SplitDown",
            "ctrl-a c": "workspace::NewTerminal",
            "ctrl-a x": "pane::CloseActiveItem",
            "ctrl-a z": "workspace::ToggleZoom",
            "ctrl-a ctrl-a": ["terminal::SendText", "\u0001"],
        },
    },
    {
        "bindings": {
            "ctrl-k ctrl-g": "git_graph::Open",
        },
    },
    {
        "context": "AcpThread",
        "unbind": {
            "alt-r": "search::ToggleRegex",
        },
    },
    {
        "context": "Pane",
        "unbind": {
            "alt-r": "search::ToggleRegex",
        },
    },
    {
        "bindings": {
            "alt-d": "multi_workspace::NextProject",
        },
    },
    {
        "bindings": {
            "alt-w": "multi_workspace::PreviousProject",
        },
    },
    {
        "context": "AcpThread",
        "unbind": {
            "alt-shift-q": "agent::AllowAlways",
        },
    },
]
