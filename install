#!/usr/bin/env python3

import argparse
import logging
import os
import re
import shutil
import sys
from pathlib import Path


# Setup colorized logging
class ColorFormatter(logging.Formatter):
    COLORS = {
        logging.DEBUG: "\033[94m",  # Blue
        logging.INFO: "\033[92m",  # Green
        logging.WARNING: "\033[93m",  # Yellow
        logging.ERROR: "\033[91m",  # Red
    }

    def format(self, record):
        color = self.COLORS.get(record.levelno, "")
        reset = "\033[0m"
        return f"{color}{record.getMessage()}{reset}"


logger = logging.getLogger("dotfiles")
handler = logging.StreamHandler()
handler.setFormatter(ColorFormatter())
logger.addHandler(handler)
logger.setLevel(logging.INFO)

# Determine if running under Windows (Native, MSYS2, or Cygwin)
IS_WINDOWS = os.name == "nt" or sys.platform in ("msys", "cygwin")


def parse_config(config_path: Path) -> list[tuple[str, Path, Path]]:
    if not config_path.is_file():
        logger.error(f"Configuration file not found: {config_path}")
        sys.exit(1)

    script_dir = config_path.parent
    links: list[tuple[str, Path, Path]] = []
    tool = None

    with config_path.open("r", encoding="utf-8") as f:
        for line_number, line in enumerate(f, start=1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue

            if line.startswith("["):
                section = re.fullmatch(r"\[([^\[\]\s]+)\]", line)
                if not section:
                    logger.error(
                        f"Invalid tool section in {config_path}:{line_number}: {line}"
                    )
                    sys.exit(1)
                tool = section[1]
                continue

            if tool is None:
                logger.error(
                    f"Mapping requires a [TOOL] section in {config_path}:{line_number}: {line}"
                )
                sys.exit(1)

            try:
                src_str, tgt_str = line.split(":", 1)
            except ValueError:
                continue

            # Evaluate variables before validating any deployment paths.
            src_str = os.path.expandvars(src_str)
            tgt_str = os.path.expandvars(tgt_str)
            if re.search(r"\$(?:\w+|\{[^}]+\})|%[^%]+%", src_str + tgt_str):
                logger.error(f"Unresolved variable in configuration: {line}")
                sys.exit(1)
            tgt_path = Path(tgt_str).expanduser()
            if not tgt_path.is_absolute():
                logger.error(f"Target must be an absolute path: {line}")
                sys.exit(1)

            if "*" in src_str or "*" in tgt_str:
                directories_only = src_str.endswith("/*/")
                src_pattern = src_str[:-1] if directories_only else src_str
                if not (
                    src_pattern.endswith("/*")
                    and tgt_str.endswith("/*")
                    and src_str.count("*") == 1
                    and tgt_str.count("*") == 1
                ):
                    logger.error(
                        "Wildcard mappings require source /* or /*/ and target /*: "
                        f"{line}"
                    )
                    sys.exit(1)

                src_dir = (script_dir / src_pattern[:-2]).expanduser().resolve()
                tgt_dir = Path(tgt_str[:-2]).expanduser()
                if not src_dir.is_dir():
                    logger.error(f"Wildcard source directory not found: {src_dir}")
                    sys.exit(1)

                for src_path in sorted(src_dir.iterdir(), key=lambda path: path.name):
                    if directories_only and not src_path.is_dir():
                        continue
                    links.append((tool, src_path.resolve(), tgt_dir / src_path.name))
                continue

            # Resolve relative source paths against the config file's directory
            src_path = (script_dir / src_str).expanduser().resolve()

            links.append((tool, src_path, tgt_path))

    return links


def select_tools(
    links: list[tuple[str, Path, Path]],
    tools: list[str],
    parser: argparse.ArgumentParser,
) -> list[tuple[Path, Path]]:
    available_tools = {tool for tool, _, _ in links}
    unknown_tools = sorted(set(tools) - available_tools)
    if unknown_tools:
        parser.error(
            f"unknown tool(s): {', '.join(unknown_tools)}; "
            f"available tools: {', '.join(sorted(available_tools))}"
        )

    selected_tools = set(tools)
    return [
        (src, tgt)
        for tool, src, tgt in links
        if not selected_tools or tool in selected_tools
    ]


def install_config(links: list[tuple[Path, Path]]):
    logger.info("Installing configuration...")
    source_dirs = set()

    for src, tgt in links:
        source_dirs.add(src if src.is_dir() else src.parent)

        if not src.exists():
            logger.error(f"Error: Source '{src}' not found. Skipping '{tgt}'.")
            continue

        if tgt.exists() or tgt.is_symlink():
            logger.warning(f"Target already exists: {tgt}")
            continue

        tgt.parent.mkdir(parents=True, exist_ok=True)

        if IS_WINDOWS:
            if src.is_dir():
                shutil.copytree(src, tgt)
            else:
                shutil.copy2(src, tgt)
            logger.info(f"Copied: {tgt}")
        else:
            tgt.symlink_to(src)
            logger.info(f"Created link: {tgt}")

    print("")
    for d in source_dirs:
        note_file = d / "NOTE.md"
        if note_file.is_file():
            print("━" * 80)
            print(f"{d.name}:")
            print("━" * 80)
            print(note_file.read_text(encoding="utf-8").strip())
            print("")


def remove_config(links: list[tuple[Path, Path]], include_files: bool):
    logger.info("Removing configuration...")

    for _, tgt in links:
        if IS_WINDOWS:
            if tgt.exists() or tgt.is_symlink():
                backup = tgt.with_name(tgt.name + ".old")

                if backup.exists():
                    if backup.is_dir() and not backup.is_symlink():
                        shutil.rmtree(backup)
                    else:
                        backup.unlink()

                shutil.move(str(tgt), str(backup))
                logger.info(f"Moved to .old: {tgt}")
            else:
                logger.warning(f"Not found: {tgt}")
        else:
            if tgt.is_symlink() or (include_files and tgt.exists()):
                if tgt.is_dir() and not tgt.is_symlink():
                    shutil.rmtree(tgt)
                else:
                    tgt.unlink()
                logger.info(f"Deleted: {tgt}")
            else:
                logger.warning(f"Not found: {tgt}")


def sync_back(links: list[tuple[Path, Path]], include_files: bool):
    logger.info("Syncing installed files back to the repository...")

    for src, tgt in links:
        if tgt.is_symlink():
            logger.warning(f"Target is a symlink (sync not needed): {tgt}")
        elif tgt.exists():
            if not include_files:
                logger.warning(
                    f"Skipping sync-back without --include-files: {tgt} -> {src}"
                )
                continue

            # Cleanly overwrite the repository source
            if src.exists():
                if src.is_dir() and not src.is_symlink():
                    shutil.rmtree(src)
                else:
                    src.unlink()

            if tgt.is_dir():
                shutil.copytree(tgt, src)
            else:
                shutil.copy2(tgt, src)

            logger.info(f"Synced back: {tgt} -> {src}")
        else:
            logger.warning(f"Installed target not found: {tgt}")


def main():
    parser = argparse.ArgumentParser(
        description="Manage dotfile configuration deployments across Linux and Windows.\n"
        "Automatically selects config_windows.conf on Windows (including Git Bash),\n"
        "or config_linux.conf on Linux and WSL.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )

    actions = parser.add_subparsers(dest="action", required=True, title="commands")
    install_parser = actions.add_parser(
        "install",
        help="Deploy configuration files to system targets.",
        description="Deploy configuration files to system targets.\n"
        "Linux: Creates symbolic links.\n"
        "Windows: Copies files/directories to bypass UAC.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )
    remove_parser = actions.add_parser(
        "remove",
        help="Remove deployed configuration files.",
        description="Remove deployed configuration files.\n"
        "Linux: Deletes symlinks.\n"
        "Windows: Moves existing targets to '.old' backups.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )
    sync_back_parser = actions.add_parser(
        "sync-back",
        help="Copy installed files back (requires --include-files).",
        description="Copy installed target files back to the repository source.\n"
        "Without --include-files, no repository files or directories are changed.\n"
        "With --include-files, replace repository sources with installed copies.\n"
        "Intended for Windows environments where configurations\n"
        "were copied instead of symlinked. Skips symlinked targets.",
        formatter_class=argparse.RawTextHelpFormatter,
        add_help=False,
    )
    command_parsers = {
        "install": install_parser,
        "remove": remove_parser,
        "sync-back": sync_back_parser,
    }

    remove_parser.add_argument(
        "--include-files",
        action="store_true",
        help="On Linux, also delete regular files/directories instead of just symlinks.",
    )
    sync_back_parser.add_argument(
        "--include-files",
        action="store_true",
        help="Allow copying installed files/directories over repository sources.",
    )
    for command_parser in command_parsers.values():
        command_parser.add_argument_group("tools").add_argument(
            "tools",
            nargs="*",
            metavar="TOOL",
            help="Only manage the named [TOOL] sections in the platform manifest.\n"
            "Omit to manage all tools.",
        )

    help_parser = actions.add_parser(
        "help",
        help="Show general or command-specific help.",
        description="Show general or command-specific help.",
        add_help=False,
    )
    command_parsers["help"] = help_parser
    help_parser.add_argument_group("command").add_argument(
        "command",
        nargs="?",
        choices=command_parsers,
        metavar="COMMAND",
        help="Command to show help for. Omit to list all commands.",
    )

    args = parser.parse_args()
    if args.action == "help":
        help_target = command_parsers[args.command] if args.command else parser
        help_target.print_help()
        return

    config_name = "config_windows.conf" if IS_WINDOWS else "config_linux.conf"
    config_path = Path(__file__).resolve().parent / config_name
    links = select_tools(parse_config(config_path), args.tools, parser)

    if args.action == "install":
        install_config(links)
    elif args.action == "remove":
        remove_config(links, args.include_files)
    else:
        sync_back(links, args.include_files)


if __name__ == "__main__":
    main()
